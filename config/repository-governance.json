{
  "branches": [
    "dev",
    "release",
    "prod"
  ],
  "labels": [
    {
      "name": "release:hotfix",
      "description": "Release Hotfix: Bump patch version x.x.X+1",
      "color": "b60205"
    },
    {
      "name": "release:major",
      "description": "Release major: Bump major version X+1.x.x",
      "color": "66cd7a"
    },
    {
      "name": "release:minor",
      "description": "Release major: Bump major version x.X+1.x",
      "color": "1d76db"
    }
  ],
  "rulesets": [
    {
      "name": "dev-[prevent-deletion]",
      "target": "branch",
      "enforcement": "active",
      "conditions": {
        "ref_name": {
          "include": [
            "refs/heads/dev"
          ],
          "exclude": []
        }
      },
      "rules": [
        {
          "type": "deletion"
        },
        {
          "type": "non_fast_forward"
        }
      ],
      "bypass_actors": []
    },
    {
      "name": "dev-[require-pr--bypass-reviewer]",
      "target": "branch",
      "enforcement": "active",
      "conditions": {
        "ref_name": {
          "include": [
            "refs/heads/dev"
          ],
          "exclude": []
        }
      },
      "rules": [
        {
          "type": "pull_request",
          "parameters": {
            "required_approving_review_count": 0,
            "dismiss_stale_reviews_on_push": false,
            "required_reviewers": [],
            "require_code_owner_review": false,
            "require_last_push_approval": false,
            "required_review_thread_resolution": false,
            "require_extra_approval_for_unattributed_changes": false,
            "allowed_merge_methods": [
              "merge",
              "squash",
              "rebase"
            ]
          }
        }
      ],
      "bypass_actors": []
    },
    {
      "name": "prod-[prevent-deletion]",
      "target": "branch",
      "enforcement": "active",
      "conditions": {
        "ref_name": {
